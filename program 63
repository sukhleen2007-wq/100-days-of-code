 #include <stdio.h>


void merge_arrays(const int arr1[], int size1, const int arr2[], int size2, int dest[]) {
    // Copy elements from the first array
    for (int i = 0; i < size1; i++) {
        dest[i] = arr1[i];
    }
    
    // Copy elements from the second array, starting where the first ended
    for (int i = 0; i < size2; i++) {
        dest[size1 + i] = arr2[i];
    }
}

// Helper function to display the array
void print_array(const int arr[], int size) {
    printf("[");
    for (int i = 0; i < size; i++) {
        printf("%d", arr[i]);
        if (i < size - 1) {
            printf(", ");
        }
    }
    printf("]\n");
}

int main() {
    int arr1[] = {1, 3, 5};
    int size1 = sizeof(arr1) / sizeof(arr1[0]);
    
    int arr2[] = {2, 4, 6, 8};
    int size2 = sizeof(arr2) / sizeof(arr2[0]);
    
    // Allocate destination array to hold all elements from both source arrays
    int merged_size = size1 + size2;
    int merged[merged_size];
    
    merge_arrays(arr1, size1, arr2, size2, merged);
    
    printf("First Array:  ");
    print_array(arr1, size1);
    
    printf("Second Array: ");
    print_array(arr2, size2);
    
    printf("Merged Array: ");
    print_array(merged, merged_size);
    
    return 0;
}
