#include <stdio.h>

int main() {
    char str1[100], str2[100];
    int i, j, len1 = 0, len2 = 0;
    int found = 0;

    printf("Enter first string: ");
    scanf("%99s", str1);

    printf("Enter second string: ");
    scanf("%99s", str2);

    while (str1[len1] != '\0')
        len1++;

    while (str2[len2] != '\0')
        len2++;

    if (len1 == len2 && len1 > 0) {

        for (i = 0; i < len1; i++) {
            for (j = 0; j < len1; j++) {
                if (str1[(i + j) % len1] != str2[j])
                    break;
            }

            if (j == len1) {
                found = 1;
                break;
            }
        }
    }

    if (found)
        printf("Strings are rotations.");
    else
        printf("Strings are not rotations.");

    return 0;
}
